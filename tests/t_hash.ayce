require hashlib as h
say(h::md5(""))
say(h::md5("abc"))
say(h::md5("El veloz murciélago hindú comía feliz cardillo y kiwis"))
say(h::sha1(""))
say(h::sha1("abc"))
say(h::sha1("The quick brown fox jumps over the lazy dog"))
say(h::sha256(""))
say(h::sha256("abc"))
say(h::sha256("The quick brown fox jumps over the lazy dog"))
say(h::sha256(bytes_from_ints([0, 1, 2, 3, 254, 255])))
say(h::sha224("abc"))
say(h::sha512(""))
say(h::sha512("abc"))
say(h::sha512("a longer message to test the multi-block behaviour of this digest implementation written in ayce"))
say(h::sha384("abc"))
say(h::md5(bytes_from_ints([104, 111, 108, 97])))
