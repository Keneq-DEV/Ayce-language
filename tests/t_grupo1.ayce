## t_grupo1.ayce — pruebas de types, copy, queue, warnings, logging
require types as T
require copy as C
require queue as Q
require warnings as W
require logging as L

## ── types ──
say("is_int(42):", T::is_int(42))              ## True
say("is_int(True):", T::is_int(True))          ## False
say("is_int(1.5):", T::is_int(1.5))            ## False
say("is_float(1.5):", T::is_float(1.5))        ## True
say("is_float(1):", T::is_float(1))            ## False
say("is_str(\"x\"):", T::is_str("x"))          ## True
say("is_bool(True):", T::is_bool(True))        ## True
say("is_bool(1):", T::is_bool(1))              ## False
say("is_list([1]):", T::is_list([1]))          ## True
say("is_dict(<>):", T::is_dict(<>))            ## True
say("is_set({1}):", T::is_set({1}))            ## True
say("is_tuple((1,)):", T::is_tuple((1, 2)))    ## True
say("is_none(none):", T::is_none(none))        ## True
say("is_none(0):", T::is_none(0))              ## False
say("is_none(\"\"):", T::is_none(""))          ## False

## ── copy ──
var l: none[] = [1, [2, 3]]
var l2: none[] = C::shallow(l)
l2[0] = 99
say("shallow lista comparte inner:", l[0], l[1][1])    ## 1 3 (inner compartido)
var l3: none[] = C::deep(l)
l3[1][0] = 77
say("deep lista no comparte:", l[1][0])        ## 2
var d: none<> = <"a": 1, "b": [4, 5]>
var d2: none<> = C::deep(d)
d2<"b">[0] = 40
say("deep dict no comparte:", d<"b">[0])       ## 4
say("deep escalar:", C::deep(5) + 1)           ## 6
var s: set = {1, 2}
var s2: set = C::shallow(s)
s2::add(3)
say("shallow set:", s::len(), s2::len())       ## 2 3

## ── queue ──
var q: none<> = Q::create()
Q::put(q, "primero")
Q::put(q, "segundo")
say("q size:", Q::size(q))                      ## 2
say("q get:", Q::get(q))                        ## primero
say("q get2:", Q::get(q))                       ## segundo
say("q size tras get:", Q::size(q))             ## 0
var q2: none<> = Q::create(5)
say("q2 creado:", Q::size(q2))                  ## 0

## ── warnings (va a stderr; aquí sólo comprobamos que no truena) ──
W::warn("cuidado")
W::warn("cuidado")                               ## no se repite
W::warn("deprecado", "DeprecationWarning")
W::reset()

## ── logging ──
L::set_level(L::INFO)
L::info("arranque")
L::warning("memoria alta")
L::error("fallo")
say("logging records:", L::getrecords()::len()) ## 3
say("OK grupo1")
