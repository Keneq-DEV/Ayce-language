{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ayce",
  "scopeName": "source.ayce",
  "patterns": [
    {
      "include": "#comments-multi"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#fstrings"
    },
    {
      "include": "#bytes-literals"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#floats"
    },
    {
      "include": "#ints"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#none-literal"
    },
    {
      "include": "#modifiers"
    },
    {
      "include": "#storage-types"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#task-decl"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-hash.ayce",
      "match": "##.*$"
    },
    "comments-multi": {
      "name": "comment.block.ayce",
      "begin": "###",
      "end": "###"
    },
    "strings": {
      "name": "string.quoted.double.ayce",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ayce",
          "match": "\\\\(n|t|r|\"|\\\\|x[0-9A-Fa-f]{2})"
        }
      ]
    },
    "fstrings": {
      "patterns": [
        {
          "name": "string.quoted.double.ayce",
          "begin": "(?<![A-Za-z0-9_])f\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ayce",
              "match": "\\\\(n|t|r|\"|\\\\|x[0-9A-Fa-f]{2})"
            },
            {
              "name": "constant.character.escape.ayce",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "name": "meta.interpolation.ayce",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "#floats"
                },
                {
                  "include": "#ints"
                },
                {
                  "include": "#booleans"
                },
                {
                  "include": "#none-literal"
                },
                {
                  "include": "#strings"
                },
                {
                  "include": "#modifiers"
                },
                {
                  "include": "#storage-types"
                },
                {
                  "include": "#keywords"
                },
                {
                  "include": "#operators"
                },
                {
                  "include": "#punctuation"
                },
                {
                  "include": "#identifiers"
                }
              ]
            }
          ]
        }
      ]
    },
    "bytes-literals": {
      "name": "string.quoted.double.bytes.ayce",
      "begin": "(?<![A-Za-z0-9_])b\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ayce",
          "match": "\\\\(n|t|r|\"|\\\\|x[0-9A-Fa-f]{2})"
        }
      ]
    },
    "floats": {
      "patterns": [
        {
          "name": "constant.numeric.float.ayce",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.float.ayce",
          "match": "\\b[0-9]+[eE][+-]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.float.ayce",
          "match": "\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.float.ayce",
          "match": "\\b[0-9]+\\.(?![A-Za-z_])"
        }
      ]
    },
    "ints": {
      "name": "constant.numeric.integer.ayce",
      "match": "\\b[0-9]+\\b"
    },
    "booleans": {
      "name": "constant.language.boolean.ayce",
      "match": "\\b(True|False)\\b"
    },
    "none-literal": {
      "name": "constant.language.null.ayce",
      "match": "\\bnone\\b"
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.ayce",
          "match": "&(in|out|inout)\\b"
        },
        {
          "name": "storage.modifier.ayce",
          "match": "\\bconst\\b"
        }
      ]
    },
    "storage-types": {
      "patterns": [
        {
          "name": "storage.type.string.ayce",
          "match": "\\bstring\\b"
        },
        {
          "name": "storage.type.int.ayce",
          "match": "\\bint\\b"
        },
        {
          "name": "storage.type.float.ayce",
          "match": "\\bfloat\\b"
        },
        {
          "name": "storage.type.bool.ayce",
          "match": "\\bbool\\b"
        },
        {
          "name": "storage.type.bytes.ayce",
          "match": "\\bbytes\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.ayce",
          "match": "\\b(if|then|else|end)\\b"
        },
        {
          "name": "keyword.control.loop.ayce",
          "match": "\\b(while|for|do|in|break|continue)\\b"
        },
        {
          "name": "keyword.control.flow.ayce",
          "match": "\\b(return|global|is)\\b"
        },
        {
          "name": "keyword.other.declaration.ayce",
          "match": "\\b(var|const)\\b"
        },
        {
          "name": "keyword.other.function.ayce",
          "match": "\\btask\\b"
        },
        {
          "name": "keyword.other.type-decl.ayce",
          "match": "\\b(Template|Shape|Variant)\\b"
        },
        {
          "name": "keyword.other.new.ayce",
          "match": "\\bnew\\b"
        },
        {
          "name": "keyword.control.error.ayce",
          "match": "\\b(try|rescue|raise)\\b"
        },
        {
          "name": "keyword.control.module.ayce",
          "match": "\\b(require|from|as)\\b"
        },
        {
          "name": "variable.language.self.ayce",
          "match": "\\bself\\b"
        },
        {
          "name": "keyword.other.io.ayce",
          "match": "\\b(say|inlet)\\b"
        },
        {
          "name": "support.function.builtin.ayce",
          "match": "\\brange\\b"
        }
      ]
    },
    "task-decl": {
      "patterns": [
        {
          "name": "entity.name.function.ayce",
          "match": "(?<=\\btask\\s)[A-Za-z_áéíóúüñÁÉÍÓÚÜÑ][A-Za-z0-9_áéíóúüñÁÉÍÓÚÜÑ]*"
        },
        {
          "name": "entity.name.function.ayce",
          "match": "(?<=::)[A-Za-z_áéíóúüñÁÉÍÓÚÜÑ][A-Za-z0-9_áéíóúüñÁÉÍÓÚÜÑ]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.ayce",
          "match": "=>"
        },
        {
          "name": "keyword.operator.comparison.ayce",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.ayce",
          "match": "(\\*\\*=|//=|\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.logical.ayce",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arithmetic.ayce",
          "match": "(\\*\\*|//|\\*|/|%|\\+|-)"
        },
        {
          "name": "keyword.operator.ternary.ayce",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.access.ayce",
          "match": "::"
        },
        {
          "name": "keyword.operator.varargs.ayce",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.pipe.ayce",
          "match": "\\|"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.colon.ayce",
          "match": ":"
        },
        {
          "name": "punctuation.separator.semicolon.ayce",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.ayce",
          "match": ","
        },
        {
          "name": "punctuation.accessor.scope.ayce",
          "match": "::"
        },
        {
          "name": "punctuation.definition.brackets.ayce",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.definition.braces.ayce",
          "match": "[\\{\\}]"
        },
        {
          "name": "punctuation.definition.parens.ayce",
          "match": "[\\(\\)]"
        },
        {
          "name": "punctuation.definition.angle.ayce",
          "match": "[<>]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.constant.ayce",
          "match": "\\b[A-Z_][A-Z0-9_]+\\b"
        },
        {
          "name": "variable.other.ayce",
          "match": "\\b[A-Za-z_áéíóúüñÁÉÍÓÚÜÑ][A-Za-z0-9_áéíóúüñÁÉÍÓÚÜÑ]*\\b"
        }
      ]
    }
  }
}
