var n: int = inlet("Altura del diamante: ", int)

if n <= 0 then
    say("La altura debe ser mayor que cero.")
else
    ## Mitad superior, incluyendo el centro cuando la altura es impar.
    for i in range(0, (n + 1) // 2) do
        var fila: string = ""

        for j in range(0, n // 2 - i) do
            fila = fila + " "
        end

        for j in range(0, 2 * i + 1) do
            fila = fila + "*"
        end

        say(fila)
    end

    ## Mitad inferior.
    for i in range(0, n // 2) do
        var fila: string = ""

        for j in range(0, i + 1) do
            fila = fila + " "
        end

        for j in range(0, 2 * (n // 2 - i) - 1) do
            fila = fila + "*"
        end

        say(fila)
    end
end