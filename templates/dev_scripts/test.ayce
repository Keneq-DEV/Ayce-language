task fizzbuzz(int n) ;
{
    for i in range(1, n + 1) do
        if (i % 3 == 0) && (i % 5 == 0) then
            say(f"{i}: FizzBuzz")
        else if i % 3 == 0 then
            say(f"{i}: Fizz")
        else if i % 5 == 0 then
            say(f"{i}: Buzz")
        else
            say(f"{i}: {i}")
        end
    end
}

fizzbuzz(15)