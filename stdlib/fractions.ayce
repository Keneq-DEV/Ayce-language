## fractions.ayce — fracciones exactas (stdlib ayce puro)
##
## Template Fraction con aritmética racional exacta.
## Tareas libres (compatibles con la API anterior):
##   fraction(n, d)         construye una Fraction normalizada
##   numerator(f)           numerador
##   denominator(f)         denominador
## Extras:
##   Fraction::add/sub/mul/div   aritmética (devuelven Fraction)
##   Fraction::to_string()       "n/d"
##   Fraction::value()           valor como float
##   Fraction::eq/lt             comparaciones
##   Fraction::is_zero/is_negative
##   from_float(x, max_den)      fracción aproximada a un float
##   gcd(a, b), lcm(a, b)

## ── máximo común divisor (euclides) ──
task gcd(int a, int b) = int ;
{
    var x: int = a
    var y: int = b
    if x < 0 then
        x = -x
    end
    if y < 0 then
        y = -y
    end
    while y != 0 do
        var r: int = x % y
        x = y
        y = r
    end
    return x
}

task lcm(int a, int b) = int ;
{
    if a == 0 || b == 0 then
        return 0
    end
    var g: int = gcd(a, b)
    return (a // g) * b
}

## ─────────────────────────────────────────────────────────────────
##  Fraction — fracción exacta (siempre normalizada: den > 0, mcd = 1)
## ─────────────────────────────────────────────────────────────────
Template Fraction {
    n: int
    d: int

    task build(int num, int den) ;
    {
        if den == 0 then
            raise Error("fractions: denominador cero", 24)
        end
        if den < 0 then
            num = -num
            den = -den
        end
        var g: int = gcd(num, den)
        if g > 1 then
            num = num // g
            den = den // g
        end
        self::n = num
        self::d = den
    }

    task num() = int ;
    {
        return self::n
    }

    task den() = int ;
    {
        return self::d
    }

    task add(Fraction other) = Fraction ;
    {
        var nuevo_n: int = self::n * other::d + other::n * self::d
        var nuevo_d: int = self::d * other::d
        return Fraction(nuevo_n, nuevo_d)
    }

    task sub(Fraction other) = Fraction ;
    {
        var nuevo_n: int = self::n * other::d - other::n * self::d
        var nuevo_d: int = self::d * other::d
        return Fraction(nuevo_n, nuevo_d)
    }

    task mul(Fraction other) = Fraction ;
    {
        return Fraction(self::n * other::n, self::d * other::d)
    }

    task div(Fraction other) = Fraction ;
    {
        if other::n == 0 then
            raise Error("fractions: división por fracción cero", 24)
        end
        return Fraction(self::n * other::d, self::d * other::n)
    }

    task neg() = Fraction ;
    {
        return Fraction(-self::n, self::d)
    }

    task abs_frac() = Fraction ;
    {
        if self::n < 0 then
            return Fraction(-self::n, self::d)
        end
        return Fraction(self::n, self::d)
    }

    task is_zero() = bool ;
    {
        return self::n == 0
    }

    task is_negative() = bool ;
    {
        return self::n < 0
    }

    task value() = float ;
    {
        return float(self::n) / float(self::d)
    }

    task to_string() = string ;
    {
        if self::d == 1 then
            return string(self::n)
        end
        return string(self::n) + "/" + string(self::d)
    }

    task eq(Fraction other) = bool ;
    {
        return self::n == other::n && self::d == other::d
    }

    task lt(Fraction other) = bool ;
    {
        return self::n * other::d < other::n * self::d
    }

    task gt(Fraction other) = bool ;
    {
        return self::n * other::d > other::n * self::d
    }
}

## ── tareas libres (compat API) ──
## fraction(1, 3) desde enteros, o fraction("0.25") desde string decimal
task fraction(int num, int den) | (string texto) = Fraction ;
{
    return Fraction(num, den)
    |
    var negado: bool = False
    var t: string = texto::trim()
    if t::starts_with("-") then
        negado = True
        t = t::slice(1, t::len())
    end
    var punto: int = t::find(".")
    var parte_ent: int = 0
    var escala: int = 1
    if punto >= 0 then
        var ent: string = t::slice(0, punto)
        var frac: string = t::slice(punto + 1, t::len())
        if ent != "" then
            parte_ent = int(ent)
        end
        var i: int = 0
        while i < frac::len() do
            var d: string = frac::slice(i, i + 1)
            parte_ent = parte_ent * 10 + int(d)
            escala = escala * 10
            i += 1
        end
    else
        if t != "" then
            parte_ent = int(t)
        end
    end
    var num2: int = parte_ent
    if negado then
        num2 = -num2
    end
    return Fraction(num2, escala)
}

## numerator: de una Fraction o de un string "n/d"
task numerator(Fraction f) | (string texto) = int ;
{
    return f::n
    |
    var idx: int = texto::find("/")
    if idx < 0 then
        return 0
    end
    return int(texto::slice(0, idx))
}

## denominator: de una Fraction o de un string "n/d"
task denominator(Fraction f) | (string texto) = int ;
{
    return f::d
    |
    var idx2: int = texto::find("/")
    if idx2 < 0 then
        return 1
    end
    return int(texto::slice(idx2 + 1, texto::len()))
}

## ── aproximar un float con denominador <= max_den ──
task from_float(float x, int max_den) = Fraction ;
{
    if x < 0.0 then
        var f: Fraction = from_float(-x, max_den)
        return f::neg()
    end
    var mejor_n: int = 0
    var mejor_d: int = 1
    var mejor_err: float = x
    var d: int = 1
    while d <= max_den do
        var n: int = int(x * float(d) + 0.5)
        if n > 0 then
            var aprox: float = float(n) / float(d)
            var err: float = x - aprox
            if err < 0.0 then
                err = -err
            end
            if err < mejor_err then
                mejor_err = err
                mejor_n = n
                mejor_d = d
            end
        end
        d = d + 1
    end
    return Fraction(mejor_n, mejor_d)
}
