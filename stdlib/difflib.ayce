## difflib.ayce — comparación de secuencias (stdlib ayce puro)
##
## Tareas:
##   ratio(a, b)                  similitud estilo SequenceMatcher (0..1)
##   levenshtein(a, b)            distancia de edición (chars)
##   levenshtein_lines(a, b)      distancia de edición entre listas de líneas
##   similarity(a, b)             1 - lev/max_len (0..1)
##   get_close_matches(word, candidatas, n, corte)  las n más parecidas
##   is_fuzzy(a, b, corte)        True si ratio >= corte
##   unified_diff(a, b, contexto) diff estilo unified sobre listas de líneas
##                                devuelve lista de líneas ("-", "+", " ", "@@")

## ── longitud de la subsecuencia común más larga (LCS) ──
task _lcs_len(string a, string b) = int ;
{
    var n: int = a::len()
    var m: int = b::len()
    ## dos filas de DP (previous y current)
    var prev: int[] = []
    var i: int = 0
    while i <= m do
        prev::append(0)
        i = i + 1
    end
    var fila: int = 0
    while fila < n do
        var cur: int[] = []
        cur::append(0)
        var col: int = 0
        while col < m do
            var ca: string = a::slice(fila, fila + 1)
            var cb: string = b::slice(col, col + 1)
            if ca == cb then
                cur::append(prev[col] + 1)
            else
                var v1: int = prev[col + 1]
                var v2: int = cur[col]
                var mejor: int = v1
                if v2 > mejor then
                    mejor = v2
                end
                cur::append(mejor)
            end
            col = col + 1
        end
        prev = cur
        fila = fila + 1
    end
    return prev[m]
}

## Similitud estilo SequenceMatcher: 2*M / (len(a) + len(b))
task ratio(string a, string b) = float ;
{
    var total: int = a::len() + b::len()
    if total == 0 then
        return 1.0
    end
    var m: int = _lcs_len(a, b)
    return float(2 * m) / float(total)
}

## Distancia de Levenshtein entre dos strings
task levenshtein(string a, string b) = int ;
{
    var n: int = a::len()
    var m: int = b::len()
    if n == 0 then
        return m
    end
    if m == 0 then
        return n
    end
    ## fila previa: distancia de a[:i] contra b vacío
    var prev: int[] = []
    var j: int = 0
    while j <= m do
        prev::append(j)
        j = j + 1
    end
    var i: int = 1
    while i <= n do
        var cur: int[] = []
        cur::append(i)
        var ca: string = a::slice(i - 1, i)
        j = 1
        while j <= m do
            var cb: string = b::slice(j - 1, j)
            var costo: int = 1
            if ca == cb then
                costo = 0
            end
            var arriba: int = prev[j] + 1
            var izq: int = cur[j - 1] + 1
            var diag: int = prev[j - 1] + costo
            var minimo: int = arriba
            if izq < minimo then
                minimo = izq
            end
            if diag < minimo then
                minimo = diag
            end
            cur::append(minimo)
            j = j + 1
        end
        prev = cur
        i = i + 1
    end
    return prev[m]
}

## Distancia de Levenshtein entre listas de líneas
task levenshtein_lines(string[] a, string[] b) = int ;
{
    var n: int = a::len()
    var m: int = b::len()
    if n == 0 then
        return m
    end
    if m == 0 then
        return n
    end
    var prev: int[] = []
    var j: int = 0
    while j <= m do
        prev::append(j)
        j = j + 1
    end
    var i: int = 1
    while i <= n do
        var cur: int[] = []
        cur::append(i)
        j = 1
        while j <= m do
            var costo: int = 1
            if a[i - 1] == b[j - 1] then
                costo = 0
            end
            var arriba: int = prev[j] + 1
            var izq: int = cur[j - 1] + 1
            var diag: int = prev[j - 1] + costo
            var minimo: int = arriba
            if izq < minimo then
                minimo = izq
            end
            if diag < minimo then
                minimo = diag
            end
            cur::append(minimo)
            j = j + 1
        end
        prev = cur
        i = i + 1
    end
    return prev[m]
}

## Similitud: 1 - levenshtein/max(len)
task similarity(string a, string b) = float ;
{
    var maximo: int = a::len()
    if b::len() > maximo then
        maximo = b::len()
    end
    if maximo == 0 then
        return 1.0
    end
    var lev: int = levenshtein(a, b)
    return 1.0 - float(lev) / float(maximo)
}

## ¿ratio(a, b) >= corte?
task is_fuzzy(string a, string b, float corte) = bool ;
{
    return ratio(a, b) >= corte
}

## Las n candidatas más parecidas a word (con ratio >= corte)
task get_close_matches(string word, string[] candidatas, int n, float corte) = string[] ;
{
    ## selección por inserción (n es chico)
    var mejores: string[] = []
    var mejores_r: float[] = []
    for c in candidatas do
        var cand: string = c
        var r: float = ratio(word, cand)
        if r >= corte then
            ## encontrar posición
            var pos: int = mejores_r::len()
            var k: int = 0
            while k < mejores_r::len() do
                if mejores_r[k] < r then
                    pos = k
                    break
                end
                k = k + 1
            end
            if pos >= n then
                pos = n - 1
            end
            if pos > mejores::len() then
                pos = mejores::len()
            end
            _insert_str(mejores, pos, cand)
            _insert_float(mejores_r, pos, r)
            if mejores::len() > n then
                mejores::delete(mejores::len() - 1)
                mejores_r::delete(mejores_r::len() - 1)
            end
        end
    end
    return mejores
}

## ── insertar en posición manteniendo la referencia (helpers) ──
task _insert_str(string[] xs, int pos, string x) ;
{
    var nueva: string[] = []
    var i: int = 0
    while i < pos do
        nueva::append(xs[i])
        i = i + 1
    end
    nueva::append(x)
    while i < xs::len() do
        nueva::append(xs[i])
        i = i + 1
    end
    xs::clear()
    xs::extend(nueva)
}

task _insert_float(float[] xs, int pos, float x) ;
{
    var nueva: float[] = []
    var i: int = 0
    while i < pos do
        nueva::append(xs[i])
        i = i + 1
    end
    nueva::append(x)
    while i < xs::len() do
        nueva::append(xs[i])
        i = i + 1
    end
    xs::clear()
    xs::extend(nueva)
}

## ── LCS a nivel de líneas (para el diff) ──
task _lcs_matches(string[] a, string[] b) = none[] ;
{
    ## devuelve lista de pares [i, j] que emparejan líneas iguales (LCS)
    var n: int = a::len()
    var m: int = b::len()
    ## tabla DP completa
    var dp: none[] = []
    var i: int = 0
    while i <= n do
        var fila: int[] = []
        var j: int = 0
        while j <= m do
            fila::append(0)
            j = j + 1
        end
        dp::append(fila)
        i = i + 1
    end
    i = n - 1
    while i >= 0 do
        var j: int = m - 1
        while j >= 0 do
            var fila_i: int[] = dp[i]
            var fila_i1: int[] = dp[i + 1]
            if a[i] == b[j] then
                fila_i[j] = fila_i1[j + 1] + 1
            else
                var v1: int = fila_i1[j]
                var v2: int = fila_i[j + 1]
                var mejor: int = v1
                if v2 > mejor then
                    mejor = v2
                end
                fila_i[j] = mejor
            end
            j = j - 1
        end
        i = i - 1
    end
    ## reconstruir el recorrido
    var out: none[] = []
    var x: int = 0
    var y: int = 0
    while x < n do
        if y < m then
            var fx: int[] = dp[x]
            var fx1: int[] = dp[x + 1]
            if a[x] == b[y] then
                var par: int[] = [x, y]
                out::append(par)
                x += 1
                y += 1
            else
                if fx1[y] >= fx[y + 1] then
                    x += 1
                else
                    y += 1
                end
            end
        else
            x += 1
        end
    end
    return out
}

## Diff estilo unified simplificado sobre listas de líneas.
## Devuelve líneas: "  igual", "- vieja", "+ nueva" (diff completo,
## sin cabeceras @@). Las líneas iguales llevan dos espacios.
task unified_diff(string[] a, string[] b, int contexto) = string[] ;
{
    var out: string[] = []
    var matches: none[] = _lcs_matches(a, b)
    var ai: int = 0
    var bi: int = 0
    for par in matches do
        var p: int[] = par
        var mi: int = p[0]
        var mj: int = p[1]
        while ai < mi do
            var ld: string = "- " + a[ai]
            out::append(ld)
            ai += 1
        end
        while bi < mj do
            var li: string = "+ " + b[bi]
            out::append(li)
            bi += 1
        end
        var lg: string = "  " + a[mi]
        out::append(lg)
        ai += 1
        bi += 1
    end
    ## restos finales sin coincidencia
    while ai < a::len() do
        var ld2: string = "- " + a[ai]
        out::append(ld2)
        ai += 1
    end
    while bi < b::len() do
        var li2: string = "+ " + b[bi]
        out::append(li2)
        bi += 1
    end
    return out
}
