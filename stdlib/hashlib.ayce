## hashlib.ayce — hashes criptográficos EN AYCE PURO (v0.6.0).
## Los algoritmos completos corren aquí, con las tablas de constantes de
## cada estándar (como los .py de CPython implementan base64/hmac/etc.):
##   - SHA-256 / SHA-224  (FIPS 180-4)
##   - SHA-512 / SHA-384  (FIPS 180-4)
##   - SHA-1              (RFC 3174)
##   - MD5                (RFC 1321)
## Padding, expansión de mensaje, rondas de compresión y salida hex:
## todo en ayce. Las únicas operaciones "de máquina" son las del propio
## lenguaje: enteros de precisión arbitraria y los operadores bit a bit.

const _HEXD: string = "0123456789abcdef"

## ── Constantes K de SHA-256 (FIPS 180-4, tabla 4.2.3) ──
const _K256: list = [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]

## ── Constantes K de SHA-512 (FIPS 180-4, tabla 4.2.5) ──
const _K512: list = [0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc, 0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118, 0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2, 0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694, 0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65, 0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5, 0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4, 0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70, 0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df, 0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b, 0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30, 0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8, 0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8, 0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3, 0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec, 0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b, 0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178, 0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b, 0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c, 0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817]

task _to_bytes_list(string s) | (bytes s) = list ;
{
    ## bytes(s) es la conversión utf-8 del lenguaje (como str.encode);
    ## b[i] devuelve cada byte como int 0..255 (nivel del lenguaje).
    var b: bytes = bytes(s)
    var out: list = []
    var i: int = 0
    while i < b::len() do
        out::append(b[i])
        i += 1
    end
    return out
    |
    var out: list = []
    var i: int = 0
    while i < s::len() do
        out::append(s[i])
        i += 1
    end
    return out
}

task _hex_from_words(list words, int nbytes) = string ;
{
    ## palabras de 32 bits big-endian → hex en minúsculas
    var s: string = ""
    var w: int = 0
    while w < words::len() && w * 4 < nbytes do
        var i: int = 3
        while i >= 0 do
            var b: int = (words[w] >> (8 * i)) & 0xFF
            s += _HEXD[b // 16]
            s += _HEXD[b % 16]
            i -= 1
        end
        w += 1
    end
    return s
}

task _hex_from_words64(list words, int nbytes) = string ;
{
    ## palabras de 64 bits big-endian → hex en minúsculas
    var s: string = ""
    var w: int = 0
    while w < words::len() && w * 8 < nbytes do
        var i: int = 7
        while i >= 0 do
            var b: int = (words[w] >> (8 * i)) & 0xFF
            s += _HEXD[b // 16]
            s += _HEXD[b % 16]
            i -= 1
        end
        w += 1
    end
    return s
}

task _rotr32(int x, int n) = int ;
{
    return ((x >> n) | (x << (32 - n))) & 0xFFFFFFFF
}

task _rotr64(int x, int n) = int ;
{
    return ((x >> n) | (x << (64 - n))) & 0xFFFFFFFFFFFFFFFF
}

task _pad64(list msg) = list ;
{
    ## padding SHA-2/SHA-1 (bloques de 64 bytes, longitud big-endian de 64 bits)
    var data: list = []
    var i: int = 0
    while i < msg::len() do
        data::append(msg[i])
        i += 1
    end
    var bl: int = msg::len() * 8
    data::append(0x80)
    while data::len() % 64 != 56 do
        data::append(0)
    end
    var j: int = 7
    while j >= 0 do
        data::append((bl >> (8 * j)) & 0xFF)
        j -= 1
    end
    return data
}

task _pad128(list msg) = list ;
{
    ## padding SHA-512 (bloques de 128 bytes, longitud big-endian de 128 bits)
    var data: list = []
    var i: int = 0
    while i < msg::len() do
        data::append(msg[i])
        i += 1
    end
    var bl: int = msg::len() * 8
    data::append(0x80)
    while data::len() % 128 != 112 do
        data::append(0)
    end
    ## longitud de 128 bits: los 64 superiores son cero (mensajes < 2^61 bytes)
    var j: int = 0
    while j < 8 do
        data::append(0)
        j += 1
    end
    j = 7
    while j >= 0 do
        data::append((bl >> (8 * j)) & 0xFF)
        j -= 1
    end
    return data
}

## ══════════════════════════════════════════════════════════════════════
##  SHA-256 / SHA-224
## ══════════════════════════════════════════════════════════════════════

task _sha256_words(list msg, list h0) = list ;
{
    var data: list = _pad64(msg)
    var hh: list = [h0[0], h0[1], h0[2], h0[3], h0[4], h0[5], h0[6], h0[7]]
    var w: list = []
    var t: int = 0
    while t < 64 do
        w::append(0)
        t += 1
    end
    var base: int = 0
    var nb: int = data::len() // 64
    var b: int = 0
    while b < nb do
        base = b * 64
        t = 0
        while t < 16 do
            w[t] = (data[base + 4 * t] << 24) | (data[base + 4 * t + 1] << 16) | (data[base + 4 * t + 2] << 8) | data[base + 4 * t + 3]
            t += 1
        end
        t = 16
        while t < 64 do
            var s0: int = _rotr32(w[t - 15], 7) ^ _rotr32(w[t - 15], 18) ^ (w[t - 15] >> 3)
            var s1: int = _rotr32(w[t - 2], 17) ^ _rotr32(w[t - 2], 19) ^ (w[t - 2] >> 10)
            w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & 0xFFFFFFFF
            t += 1
        end
        var a: int = hh[0]
        var bb: int = hh[1]
        var c: int = hh[2]
        var d: int = hh[3]
        var e: int = hh[4]
        var f: int = hh[5]
        var g: int = hh[6]
        var h: int = hh[7]
        t = 0
        while t < 64 do
            var S1: int = _rotr32(e, 6) ^ _rotr32(e, 11) ^ _rotr32(e, 25)
            var ch: int = (e & f) ^ ((~e & 0xFFFFFFFF) & g)
            var T1: int = (h + S1 + ch + _K256[t] + w[t]) & 0xFFFFFFFF
            var S0: int = _rotr32(a, 2) ^ _rotr32(a, 13) ^ _rotr32(a, 22)
            var maj: int = (a & bb) ^ (a & c) ^ (bb & c)
            var T2: int = (S0 + maj) & 0xFFFFFFFF
            h = g
            g = f
            f = e
            e = (d + T1) & 0xFFFFFFFF
            d = c
            c = bb
            bb = a
            a = (T1 + T2) & 0xFFFFFFFF
            t += 1
        end
        hh[0] = (hh[0] + a) & 0xFFFFFFFF
        hh[1] = (hh[1] + bb) & 0xFFFFFFFF
        hh[2] = (hh[2] + c) & 0xFFFFFFFF
        hh[3] = (hh[3] + d) & 0xFFFFFFFF
        hh[4] = (hh[4] + e) & 0xFFFFFFFF
        hh[5] = (hh[5] + f) & 0xFFFFFFFF
        hh[6] = (hh[6] + g) & 0xFFFFFFFF
        hh[7] = (hh[7] + h) & 0xFFFFFFFF
        b += 1
    end
    return hh
}

task _sha256_bytes(stdlib::Cualquiera s) = list ;
{
    var msg: list = _to_bytes_list(s)
    var h0: list = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    var hh: list = _sha256_words(msg, h0)
    var out: list = []
    var w: int = 0
    while w < 8 do
        var i: int = 3
        while i >= 0 do
            out::append((hh[w] >> (8 * i)) & 0xFF)
            i -= 1
        end
        w += 1
    end
    return out
}

task _sha224_bytes(stdlib::Cualquiera s) = list ;
{
    var msg: list = _to_bytes_list(s)
    var h0: list = [0xc1059ed8, 0x367cd507, 0x3070dd17, 0xf70e5939, 0xffc00b31, 0x68581511, 0x64f98fa7, 0xbefa4fa4]
    var hh: list = _sha256_words(msg, h0)
    var out: list = []
    var w: int = 0
    while w < 7 do
        var i: int = 3
        while i >= 0 do
            out::append((hh[w] >> (8 * i)) & 0xFF)
            i -= 1
        end
        w += 1
    end
    return out
}

task _bytes_to_hex(list bs) = string ;
{
    var s: string = ""
    var i: int = 0
    while i < bs::len() do
        s += _HEXD[bs[i] // 16]
        s += _HEXD[bs[i] % 16]
        i += 1
    end
    return s
}

## ══════════════════════════════════════════════════════════════════════
##  SHA-512 / SHA-384
## ══════════════════════════════════════════════════════════════════════

task _sha512_words(list msg, list h0) = list ;
{
    var data: list = _pad128(msg)
    var hh: list = [h0[0], h0[1], h0[2], h0[3], h0[4], h0[5], h0[6], h0[7]]
    var w: list = []
    var t: int = 0
    while t < 80 do
        w::append(0)
        t += 1
    end
    var base: int = 0
    var nb: int = data::len() // 128
    var b: int = 0
    while b < nb do
        base = b * 128
        t = 0
        while t < 16 do
            var j: int = 0
            var acc: int = 0
            while j < 8 do
                acc = (acc << 8) | data[base + 8 * t + j]
                j += 1
            end
            w[t] = acc
            t += 1
        end
        t = 16
        while t < 80 do
            var s0: int = _rotr64(w[t - 15], 1) ^ _rotr64(w[t - 15], 8) ^ (w[t - 15] >> 7)
            var s1: int = _rotr64(w[t - 2], 19) ^ _rotr64(w[t - 2], 61) ^ (w[t - 2] >> 6)
            w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & 0xFFFFFFFFFFFFFFFF
            t += 1
        end
        var a: int = hh[0]
        var bb: int = hh[1]
        var c: int = hh[2]
        var d: int = hh[3]
        var e: int = hh[4]
        var f: int = hh[5]
        var g: int = hh[6]
        var h: int = hh[7]
        t = 0
        while t < 80 do
            var S1: int = _rotr64(e, 14) ^ _rotr64(e, 18) ^ _rotr64(e, 41)
            var ch: int = (e & f) ^ ((~e & 0xFFFFFFFFFFFFFFFF) & g)
            var T1: int = (h + S1 + ch + _K512[t] + w[t]) & 0xFFFFFFFFFFFFFFFF
            var S0: int = _rotr64(a, 28) ^ _rotr64(a, 34) ^ _rotr64(a, 39)
            var maj: int = (a & bb) ^ (a & c) ^ (bb & c)
            var T2: int = (S0 + maj) & 0xFFFFFFFFFFFFFFFF
            h = g
            g = f
            f = e
            e = (d + T1) & 0xFFFFFFFFFFFFFFFF
            d = c
            c = bb
            bb = a
            a = (T1 + T2) & 0xFFFFFFFFFFFFFFFF
            t += 1
        end
        hh[0] = (hh[0] + a) & 0xFFFFFFFFFFFFFFFF
        hh[1] = (hh[1] + bb) & 0xFFFFFFFFFFFFFFFF
        hh[2] = (hh[2] + c) & 0xFFFFFFFFFFFFFFFF
        hh[3] = (hh[3] + d) & 0xFFFFFFFFFFFFFFFF
        hh[4] = (hh[4] + e) & 0xFFFFFFFFFFFFFFFF
        hh[5] = (hh[5] + f) & 0xFFFFFFFFFFFFFFFF
        hh[6] = (hh[6] + g) & 0xFFFFFFFFFFFFFFFF
        hh[7] = (hh[7] + h) & 0xFFFFFFFFFFFFFFFF
        b += 1
    end
    return hh
}

task _sha512_bytes(stdlib::Cualquiera s) = list ;
{
    var msg: list = _to_bytes_list(s)
    var h0: list = [0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1, 0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179]
    var hh: list = _sha512_words(msg, h0)
    var out: list = []
    var w: int = 0
    while w < 8 do
        var i: int = 7
        while i >= 0 do
            out::append((hh[w] >> (8 * i)) & 0xFF)
            i -= 1
        end
        w += 1
    end
    return out
}

task _sha384_bytes(stdlib::Cualquiera s) = list ;
{
    var msg: list = _to_bytes_list(s)
    var h0: list = [0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939, 0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4]
    var hh: list = _sha512_words(msg, h0)
    var out: list = []
    var w: int = 0
    while w < 6 do
        var i: int = 7
        while i >= 0 do
            out::append((hh[w] >> (8 * i)) & 0xFF)
            i -= 1
        end
        w += 1
    end
    return out
}

## ══════════════════════════════════════════════════════════════════════
##  SHA-1 (RFC 3174)
## ══════════════════════════════════════════════════════════════════════

task _sha1_bytes(stdlib::Cualquiera s) = list ;
{
    var msg: list = _to_bytes_list(s)
    var data: list = _pad64(msg)
    var hh: list = [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0]
    var w: list = []
    var t: int = 0
    while t < 80 do
        w::append(0)
        t += 1
    end
    var base: int = 0
    var nb: int = data::len() // 64
    var b: int = 0
    while b < nb do
        base = b * 64
        t = 0
        while t < 16 do
            w[t] = (data[base + 4 * t] << 24) | (data[base + 4 * t + 1] << 16) | (data[base + 4 * t + 2] << 8) | data[base + 4 * t + 3]
            t += 1
        end
        t = 16
        while t < 80 do
            ## rotación izquierda por 1 (no desplazamiento: el bit alto vuelve)
            var x: int = w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16]
            w[t] = ((x << 1) | (x >> 31)) & 0xFFFFFFFF
            t += 1
        end
        var a: int = hh[0]
        var bb: int = hh[1]
        var c: int = hh[2]
        var d: int = hh[3]
        var e: int = hh[4]
        t = 0
        while t < 80 do
            var f: int = 0
            var k: int = 0
            if t < 20 then
                f = (bb & c) | ((~bb & 0xFFFFFFFF) & d)
                k = 0x5A827999
            else
                if t < 40 then
                    f = bb ^ c ^ d
                    k = 0x6ED9EBA1
                else
                    if t < 60 then
                        f = (bb & c) | (bb & d) | (c & d)
                        k = 0x8F1BBCDC
                    else
                        f = bb ^ c ^ d
                        k = 0xCA62C1D6
                    end
                end
            end
            ## a <<< 5 — rotación (los 5 bits altos vuelven por la derecha)
            var tmp: int = (((a << 5) | (a >> 27)) + f + e + k + w[t]) & 0xFFFFFFFF
            e = d
            d = c
            c = _rotr32(bb, 2)
            bb = a
            a = tmp
            t += 1
        end
        hh[0] = (hh[0] + a) & 0xFFFFFFFF
        hh[1] = (hh[1] + bb) & 0xFFFFFFFF
        hh[2] = (hh[2] + c) & 0xFFFFFFFF
        hh[3] = (hh[3] + d) & 0xFFFFFFFF
        hh[4] = (hh[4] + e) & 0xFFFFFFFF
        b += 1
    end
    var out: list = []
    var wi: int = 0
    while wi < 5 do
        var i: int = 3
        while i >= 0 do
            out::append((hh[wi] >> (8 * i)) & 0xFF)
            i -= 1
        end
        wi += 1
    end
    return out
}

## ══════════════════════════════════════════════════════════════════════
##  MD5 (RFC 1321)
## ══════════════════════════════════════════════════════════════════════

## K[i] = floor(2^32·|sen(i+1)|) — tabla del RFC 1321 (FIPS de tanvier)
const _KMD5: list = [0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501, 0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821, 0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8, 0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a, 0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70, 0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665, 0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1, 0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391]

## desplazamientos s por ronda (RFC 1321)
const _SMD5: list = [7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21]

task _rotl32(int x, int n) = int ;
{
    return ((x << n) | (x >> (32 - n))) & 0xFFFFFFFF
}

task _md5_bytes(stdlib::Cualquiera s) = list ;
{
    var msg: list = _to_bytes_list(s)
    ## padding MD5: longitud LITTLE-endian de 64 bits
    var data: list = []
    var i: int = 0
    while i < msg::len() do
        data::append(msg[i])
        i += 1
    end
    var bl: int = msg::len() * 8
    data::append(0x80)
    while data::len() % 64 != 56 do
        data::append(0)
    end
    var j: int = 0
    while j < 8 do
        data::append((bl >> (8 * j)) & 0xFF)
        j += 1
    end
    var hh: list = [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476]
    var m: list = []
    var t: int = 0
    while t < 16 do
        m::append(0)
        t += 1
    end
    var nb: int = data::len() // 64
    var b: int = 0
    while b < nb do
        var base: int = b * 64
        t = 0
        while t < 16 do
            m[t] = data[base + 4 * t] | (data[base + 4 * t + 1] << 8) | (data[base + 4 * t + 2] << 16) | (data[base + 4 * t + 3] << 24)
            t += 1
        end
        var a: int = hh[0]
        var bb: int = hh[1]
        var c: int = hh[2]
        var d: int = hh[3]
        t = 0
        while t < 64 do
            var f: int = 0
            var g: int = 0
            if t < 16 then
                f = (bb & c) | ((~bb & 0xFFFFFFFF) & d)
                g = t
            else
                if t < 32 then
                    f = (d & bb) | ((~d & 0xFFFFFFFF) & c)
                    g = (5 * t + 1) % 16
                else
                    if t < 48 then
                        f = bb ^ c ^ d
                        g = (3 * t + 5) % 16
                    else
                        f = c ^ (bb | (~d & 0xFFFFFFFF))
                        g = (7 * t) % 16
                    end
                end
            end
            var tmp: int = (f + a + _KMD5[t] + m[g]) & 0xFFFFFFFF
            a = d
            d = c
            c = bb
            bb = (bb + _rotl32(tmp, _SMD5[t])) & 0xFFFFFFFF
            t += 1
        end
        hh[0] = (hh[0] + a) & 0xFFFFFFFF
        hh[1] = (hh[1] + bb) & 0xFFFFFFFF
        hh[2] = (hh[2] + c) & 0xFFFFFFFF
        hh[3] = (hh[3] + d) & 0xFFFFFFFF
        b += 1
    end
    var out: list = []
    var wi: int = 0
    while wi < 4 do
        ## salida LITTLE-endian, como el RFC
        var i2: int = 0
        while i2 < 4 do
            out::append((hh[wi] >> (8 * i2)) & 0xFF)
            i2 += 1
        end
        wi += 1
    end
    return out
}

## ══════════════════════════════════════════════════════════════════════
##  API pública (mismas firmas que la versión anterior)
## ══════════════════════════════════════════════════════════════════════

task md5(string datos) | (bytes datos) = string ;
{
    return _bytes_to_hex(_md5_bytes(datos))
    |
    return _bytes_to_hex(_md5_bytes(datos))
}

task sha1(string datos) | (bytes datos) = string ;
{
    return _bytes_to_hex(_sha1_bytes(datos))
    |
    return _bytes_to_hex(_sha1_bytes(datos))
}

task sha256(string datos) | (bytes datos) = string ;
{
    return _bytes_to_hex(_sha256_bytes(datos))
    |
    return _bytes_to_hex(_sha256_bytes(datos))
}

task sha512(string datos) | (bytes datos) = string ;
{
    return _bytes_to_hex(_sha512_bytes(datos))
    |
    return _bytes_to_hex(_sha512_bytes(datos))
}

task sha224(string s) | (bytes datos) = string ;
{
    return _bytes_to_hex(_sha224_bytes(s))
    |
    return _bytes_to_hex(_sha224_bytes(datos))
}

task sha384(string s) | (bytes datos) = string ;
{
    return _bytes_to_hex(_sha384_bytes(s))
    |
    return _bytes_to_hex(_sha384_bytes(datos))
}
