## secrets.ayce — aleatoridad criptográfica EN AYCE PURO (v0.6.0).
## Toda la entropía viene del builtin global urandom() — el mismo contacto
## con el SO que secrets.py de CPython (que usa os.urandom a través de
## SystemRandom). La selección con rechazo (_rand_below) es el mismo
## algoritmo de random.py SystemRandom.

require base64 as b64

task token_hex() | (int n) = string ;
{
    ## nbytes por defecto: 32 (como secrets.token_hex de CPython)
    return _token_hex_n(32)
    |
    if n < 0 then
        raise Error("secrets::token_hex: n negativo", 1)
    end
    return _token_hex_n(n)
}

task _token_hex_n(int nb) = string ;
{
    var ent: bytes = urandom(nb)
    var out: string = ""
    var i: int = 0
    while i < ent::len() do
        var b: int = ent[i]
        var hi: int = b // 16
        var lo: int = b % 16
        if hi < 10 then
            out += chr(48 + hi)
        else
            out += chr(87 + hi)
        end
        if lo < 10 then
            out += chr(48 + lo)
        else
            out += chr(87 + lo)
        end
        i += 1
    end
    return out
}

task token_urlsafe() | (int n) = string ;
{
    return _token_urlsafe_n(32)
    |
    if n < 0 then
        raise Error("secrets::token_urlsafe: n negativo", 1)
    end
    return _token_urlsafe_n(n)
}

task _token_urlsafe_n(int nb) = string ;
{
    ## base64 urlsafe del entropy, sin el relleno '=' (como CPython)
    var ent: bytes = urandom(nb)
    var s: string = b64::encode(ent)
    ## recorta los '=' finales
    var fin: int = s::len()
    while fin > 0 do
        if s[fin - 1] == "=" then
            fin -= 1
        else
            break
        end
    end
    var out: string = ""
    var i: int = 0
    while i < fin do
        out += s[i]
        i += 1
    end
    return out
}

task _bit_len(int n) = int ;
{
    var c: int = 0
    while n > 0 do
        n = n >> 1
        c += 1
    end
    return c
}

task rand_below(int n) = int ;
{
    ## entero uniforme en [0, n) con rechazo, igual que SystemRandom._randbelow
    if n <= 0 then
        raise Error("secrets::rand_below: n debe ser positivo", 1)
    end
    var bits: int = _bit_len(n)
    var nbytes: int = (bits + 7) // 8
    var r: int = _urand_bits(nbytes, bits)
    while r >= n do
        r = _urand_bits(nbytes, bits)
    end
    return r
}

task _urand_bits(int nbytes, int bits) = int ;
{
    ## int.from_bytes(urandom(nbytes), "big") >> (nbytes·8 − bits)
    var ent: bytes = urandom(nbytes)
    var x: int = 0
    var i: int = 0
    while i < nbytes do
        x = (x << 8) | ent[i]
        i += 1
    end
    return x >> (nbytes * 8 - bits)
}

task choice(stdlib::Cualquiera seq) ;
{
    return seq[rand_below(seq::len())]
}
