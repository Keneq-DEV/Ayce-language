## types.ayce — verificación de tipos EN AYCE PURO (v0.6.0).
## Sin primitivas: cada predicado es una task con sobrecargas por tipo.
## El despacho de sobrecargas del lenguaje es estricto (bool no es int),
## así que el orden de las firmas hace el trabajo — el equivalente de
## isinstance() con tipos exactos en CPython. is_none compara con el
## literal none, igual que `x is None` de CPython.

## ── is_int: True sólo para int exacto (un bool NO es int) ──
task is_int(bool x) = bool ;
{
    return False
}
task is_int(float x) = bool ;
{
    return False
}
task is_int(string x) = bool ;
{
    return False
}
task is_int(list x) = bool ;
{
    return False
}
task is_int(dict x) = bool ;
{
    return False
}
task is_int(tuple x) = bool ;
{
    return False
}
task is_int(set x) = bool ;
{
    return False
}
task is_int(int x) = bool ;
{
    return True
}

