task factorial(int n) = int ;
{
    if n < 0 then
        raise Error("math::factorial: n negativo", 1)
    end
    var r: int = 1
    var i: int = 2
    while i <= n do
        r *= i
        i += 1
    end
    return r
}

task isqrt(int n) = int ;
{
    ## parte entera de √n por Newton entero (exacta)
    if n < 0 then
        raise Error("math::isqrt: n negativo", 1)
    end
    if n < 2 then
        return n
    end
    var r: int = n
    var t: int = 0
    while t < 200 do
        var r2: int = (r + n // r) // 2
        if r2 >= r then
            return r
        end
        r = r2
        t += 1
    end
    return r
}

task perm(int n, int n2) = int ;
{
    if n2 < 0 || n2 > n then
        raise Error("math::perm: requiere 0 <= k <= n", 1)
    end
    var r: int = 1
    var i: int = 0
    while i < n2 do
        r *= n - i
        i += 1
    end
    return r
}

task comb(int n, int n2) = int ;
{
    if n2 < 0 || n2 > n then
        return 0
    end
    ## producto escalonado: cada paso r·(n−i)//(i+1) es exacto porque
    ## el resultado intermedio es C(n, i+1)
    var r: int = 1
    var i: int = 0
    while i < n2 do
        r = r * (n - i) // (i + 1)
        i += 1
    end
    return r
}

task isclose(int n, int n2) | (int n, float x) | (float x, int n) | (float x, float x2) | (int n, int n2, int n3) | (int n, int n2, float x) | (int n, float x, int n3) | (int n, float x, float x3) | (float x, int n, int n3) | (float x, int n, float x3) | (float x, float x2, int n) | (float x, float x2, float x3) = bool ;
{
    return _isclose2(float(n), float(n2))
    |
    return _isclose2(float(n), x)
    |
    return _isclose2(x, float(n))
    |
    return _isclose2(x, x2)
    |
    return _isclose3(float(n), float(n2), float(n3))
    |
    return _isclose3(float(n), float(n2), x)
    |
    return _isclose3(float(n), x, float(n3))
    |
    return _isclose3(float(n), x, x3)
    |
    return _isclose3(x, float(n), float(n3))
    |
    return _isclose3(x, float(n), x3)
    |
    return _isclose3(x, x2, float(n))
    |
    return _isclose3(x, x2, x3)
}

