task dist(none[] arg, none[] arg2) = float ;
{
    ## distancia euclídea entre dos vectores, escalada para no desbordar
    if arg::len() != arg2::len() then
        raise Error("math::dist: listas de distinta longitud", 1)
    end
    var n: int = arg::len()
    var mx: float = 0.0
    var i: int = 0
    while i < n do
        var d: float = _abs_f(float(arg[i]) - float(arg2[i]))
        if d > mx then
            mx = d
        end
        i += 1
    end
    if mx == 0.0 then
        return 0.0
    end
    var total: float = 0.0
    i = 0
    while i < n do
        var q: float = (float(arg[i]) - float(arg2[i])) / mx
        total += q * q
        i += 1
    end
    return mx * _sqrt_core(total)
}

