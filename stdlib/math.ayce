task _erf_f(float x) = float ;
{
    if x > 1.5 then
        return 1.0 - _erfc_cf(x)
    end
    if x < -1.5 then
        return _erfc_cf(-x) - 1.0
    end
    return _erf_series(x)
}

task _erfc_f(float x) = float ;
{
    if x < 0.0 then
        return 2.0 - _erfc_f(-x)
    end
    if x <= 1.5 then
        return 1.0 - _erf_series(x)
    end
    return _erfc_cf(x)
}
