    return _round_he(x)
    |
    return x
    |
    return _round_scaled(x, decimales)
}

task _frexp_m(float x) = int ;
{
    ## descompone |x| = f·2^e con f ∈ [0.5, 1) y devuelve m = f·2^53
    ## (entero exacto: m·2^(e-53) reproduce x sin pérdida)
    var f: float = x
    var e: int = 0
    while f >= 1.0 do
        f = f * 0.5
        e += 1
    end
    while f < 0.5 do
        f = f * 2.0
        e -= 1
    end
    var t: float = f
    var s: int = 53
    while s > 0 do
        t = t * 2.0
        s -= 1
    end
    return int(t)
}

task _frexp_e(float x) = int ;
{
    ## exponente e de la descomposición |x| = f·2^e, f ∈ [0.5, 1)
    var f: float = x
    var e: int = 0
    while f >= 1.0 do
        f = f * 0.5
        e += 1
    end
    while f < 0.5 do
        f = f * 2.0
        e -= 1
    end
    return e
}

task _round_div_he(int q, int r, int half) = int ;
{
    ## q + redondeo al par del resto r frente a la mitad del denominador
    if r > half then
        return q + 1
    end
    if r < half then
        return q
    end
    if q % 2 == 0 then
        return q
    end
    return q + 1
}

task _round_scaled(float x, int n) = float ;
{
    ## round(x, n) con redondeo correcto al valor decimal EXACTO del double,
    ## como _Py_dg_dtoa en CPython (el escalado float introduce errores:
    ## 2.675·100 = 267.5 exacto en float, pero el valor de 2.675 es
    ## 2.6749999999999998223... → round(2.675, 2) = 2.67).
    ## x = m·2^p (m de 53 bits, exacto) → x·10^n = m·5^n·2^(p+n) y el
    ## redondeo se hace con enteros exactos.
    if x == 0.0 then
        return x
    end
    var neg: bool = False
    var a: float = x
    if a < 0.0 then
        neg = True
        a = -a
    end
    var m: int = _frexp_m(a)
    var p: int = _frexp_e(a) - 53
    var N: int = 0
    var res: float = 0.0
    if n >= 0 then
        var ee: int = p + n
        if ee >= 0 then
            ## x·10^n es un entero exacto: no hay nada que redondear
            N = m * _ipow(5, n) * _ipow(2, ee)
            res = float(N) / float(_ipow(10, n))
        else
            var M: int = m * _ipow(5, n)
            var d2: int = _ipow(2, -ee)
            var q: int = M // d2
            var r: int = M - q * d2
            N = _round_div_he(q, r, d2 // 2)
            res = float(N) / float(_ipow(10, n))
        end
    else
        var k: int = -n
        var ee: int = p - k
        if ee >= 0 then
            var M: int = m * _ipow(2, ee)
            var den: int = _ipow(5, k)
            var q: int = M // den
            var r: int = M - q * den
            ## 5^k es impar: no hay empate exacto; compara 2r con den
            if 2 * r > den then
                N = q + 1
            else
                N = q
            end
            res = float(N) * float(_ipow(10, k))
        else
            var den: int = _ipow(2, -ee) * _ipow(5, k)
            var q: int = m // den
            var r: int = m - q * den
            N = _round_div_he(q, r, den // 2)
            res = float(N) * float(_ipow(10, k))
        end
    end
    if neg then
        return -res
    end
    return res
}

task _pow10_int(int n) = int ;
{
    var r: int = 1
    var i: int = 0
    while i < n do
        r *= 10
        i += 1
    end
    return r
}

